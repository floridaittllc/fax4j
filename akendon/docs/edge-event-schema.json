{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EdgeEvent",
  "type": "object",
  "required": [
    "device_id",
    "site_id",
    "camera_id",
    "label",
    "score",
    "ts_start",
    "raw_json"
  ],
  "properties": {
    "device_id": {"type": "string"},
    "site_id": {"type": "string"},
    "camera_id": {"type": "string"},
    "label": {"type": "string"},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "ts_start": {"type": "number", "description": "Unix timestamp"},
    "ts_end": {"type": ["number", "null"], "description": "Unix timestamp"},
    "snapshot_path": {"type": ["string", "null"]},
    "clip_path": {"type": ["string", "null"]},
    "raw_json": {"type": "object"}
  },
  "additionalProperties": true
}
